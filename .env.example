DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_guild_id
# Whisper server endpoint. Set to your whisper.cpp server URL.
# The app container uses host networking for Discord voice, so localhost reaches the host directly.
WHISPER_ENDPOINT=http://localhost:8080
POSTGRES_PASSWORD=CHANGE_ME
RUST_LOG=info,serenity=warn,songbird=warn
# Production compose must use an explicit release tag or digest. Avoid "latest"
# outside local smoke tests because it is mutable.
# DISCORD_TRANSCRIPT_IMAGE=ghcr.io/xpadev-net/discord-transcript:vX.Y.Z

# The following variables are set automatically by docker-compose.yml.
# When running outside Docker, uncomment and configure them.
# DATABASE_URL=postgresql://user:pass@localhost/discord_transcript
# Only the in-process native summary harness is supported.
# SUMMARY_HARNESS=native
# Native harness settings (optional-but-preserved; the summary client
# reports disabled per job until provider + key + model are all set):
# SUMMARY_PROVIDER=opencode_go      # provider for SUMMARY_HARNESS=native: opencode_go | chatgpt
# OPENCODE_API_KEY=...              # native OpenCode Go provider API key
# ChatGPT subscription (SUMMARY_PROVIDER=chatgpt): run `auth login-chatgpt`
# once to write the OAuth credential file below; it is refreshed on use.
# A static access token can replace the file when both are absent.
# CHATGPT_AUTH_FILE=/run/secrets/chatgpt-auth.json
# CHATGPT_ACCESS_TOKEN=...          # optional static token (e.g. Enterprise)
# CHATGPT_ACCOUNT_ID=...            # optional; for static tokens
# SUMMARY_MODEL=grok-code-fast-1    # model id; grok*/gpt* ids use /responses,
#                                 # other ids use /chat/completions
# CHUNK_STORAGE_DIR points to the workspace root (workspaces/<guild>/<voice>/<meeting>/...).
# CHUNK_STORAGE_DIR=/var/data/chunks
# Recording storage backend: local (default) or s3.
# CHUNK_STORAGE_BACKEND=local
# Required when CHUNK_STORAGE_BACKEND=s3. Any S3-compatible service works via
# CHUNK_STORAGE_S3_ENDPOINT (MinIO, Cloudflare R2, etc.). With s3, CHUNK_STORAGE_DIR
# is still used for recording-time staging files and workspaces.
# CHUNK_STORAGE_S3_BUCKET=recordings
# CHUNK_STORAGE_S3_ACCESS_KEY_ID=...
# CHUNK_STORAGE_S3_SECRET_ACCESS_KEY=...
# CHUNK_STORAGE_S3_ENDPOINT=https://s3.example.com  # optional; omit for AWS
# CHUNK_STORAGE_S3_REGION=us-east-1                 # optional; R2 uses 'auto'
# CHUNK_STORAGE_S3_KEY_PREFIX=discord/              # optional key prefix
# CHUNK_STORAGE_S3_FORCE_PATH_STYLE=true            # optional; defaults to true when a custom endpoint is set
# CHUNK_STORAGE_S3_PRESIGN_TTL_SECONDS=900          # optional; playback URL lifetime (max 604800)
# AUTO_STOP_GRACE_SECONDS=60
# WHISPER_LANGUAGE=ja
# WHISPER_BEAM_SIZE=5               # default: 5 (set to 1 for greedy/fastest)
# WHISPER_SUPPRESS_NON_SPEECH=true  # default: true
# WHISPER_PROMPT=                   # default: unset
# WHISPER_VAD=true                  # default: true
# WHISPER_TEMPERATURE=0.0           # default: 0.0 (deterministic decoding)
# WHISPER_RESAMPLE_TO_16K=true      # default: true
# PUBLIC_BASE_URL=https://transcripts.example.com
# WEB_PORT=3000
# Keep loopback-only when using host networking unless a reverse proxy or public
# listener is intentionally required.
# WEB_BIND_HOST=127.0.0.1

# Discord OAuth (required for web authentication)
# Create at https://discord.com/developers/applications → OAuth2
# Add redirect URI: {PUBLIC_BASE_URL}/auth/callback
# DISCORD_CLIENT_ID=your_application_client_id
# DISCORD_CLIENT_SECRET=your_oauth2_client_secret
# WEB_SESSION_SECRET=random_secret_for_signing_cookies
